---
interface Props {
  mode: 'scene' | 'corner'
}

const { mode } = Astro.props
---

{mode === 'scene' && (
  <>
    <div id="scene" aria-hidden="true"></div>
    <div class="scrim"></div>
  </>
)}
<div id="bubble" aria-hidden="true"></div>
<canvas id="mini" aria-hidden="true"></canvas>

<script>
  const start = () => import('../scripts/oyen')
  const whenIdle = () =>
    'requestIdleCallback' in window
      ? requestIdleCallback(start)
      : setTimeout(start)
  addEventListener('load', whenIdle, { once: true })
</script>

<style>
  #scene {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      180deg,
      #c6dcea 0%,
      #e2ecf2 38%,
      var(--ice) 47%
    );
  }

  #scene :global(canvas) {
    width: 100%;
    height: 100%;
  }

  .scrim {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      var(--ice) 0%,
      var(--ice) 46%,
      rgb(238 243 246 / 0.85) 52%,
      rgb(238 243 246 / 0) 63%
    );
  }

  #bubble {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 3;
    width: max-content;
    max-width: 250px;
    padding: 10px 14px;
    border-radius: 14px 14px 2px 14px;
    background: var(--ink);
    color: var(--ice);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.45;
    opacity: 0;
    transform: translate(-100%, -100%) translateY(8px) scale(0.96);
    transform-origin: bottom right;
    transition:
      opacity 0.18s,
      transform 0.25s cubic-bezier(0.2, 1.4, 0.4, 1);
    pointer-events: none;
  }

  #bubble.show {
    opacity: 1;
    transform: translate(-100%, -100%);
  }

  #mini {
    display: none;
    position: fixed;
    right: 16px;
    bottom: 0;
    z-index: 5;
    width: 170px;
    height: 207px;
    opacity: 0;
    transform: translateY(40px);
    pointer-events: none;
    cursor: pointer;
    transition:
      opacity 0.25s,
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  :global(body[data-oyen='corner']) #mini {
    display: block;
  }

  #mini.show {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  #bubble.corner {
    top: auto;
    right: 44px;
    bottom: 206px;
    left: auto;
    transform: translateY(8px) scale(0.96);
  }

  #bubble.corner.show {
    transform: none;
  }

  @media (max-width: 1100px) {
    #scene,
    .scrim {
      position: absolute;
      inset: 0 0 auto 0;
      height: 46vh;
      min-height: 300px;
    }

    .scrim {
      background: linear-gradient(
        180deg,
        rgb(238 243 246 / 0) 70%,
        var(--ice) 100%
      );
    }

    #bubble {
      position: absolute;
      max-width: min(230px, 42vw);
      font-size: 12px;
    }

    #mini {
      display: block;
      right: 6px;
      width: 120px;
      height: 146px;
    }

    #bubble.corner {
      position: fixed;
      right: 14px;
      bottom: 150px;
    }
  }
</style>
