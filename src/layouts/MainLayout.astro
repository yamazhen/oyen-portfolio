---
import Head from './Head.astro'
import Oyen from '../components/Oyen.astro'
import { ui, type Lang } from '../data/ui'
import '../styles/reset.css'
import '../styles/global.css'
import '../styles/prose.css'

interface Props {
  lang: Lang
  title?: string
  description?: string
  oyen?: 'scene' | 'corner'
}

const {
  lang,
  title = 'Bowen Chong',
  description = ui[lang].description,
  oyen,
} = Astro.props
---

<html lang={lang}>
  <head>
    <Head lang={lang} title={title} description={description} />
  </head>
  <body data-oyen={oyen}>
    <slot />
    {oyen && <Oyen mode={oyen} />}
  </body>
</html>
