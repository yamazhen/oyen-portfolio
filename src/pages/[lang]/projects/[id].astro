---
import { getCollection, render } from 'astro:content'
import LangSwitch from '../../../components/LangSwitch.astro'
import MainLayout from '../../../layouts/MainLayout.astro'
import { site } from '../../../data/site'
import { inLang, langs, projectPath, projectSlug, ui } from '../../../data/ui'
import { byOrder } from '../../../lib/order'

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(byOrder)
  return langs.flatMap((lang) => {
    const own = projects.filter(inLang(lang))
    return own.map((project, i) => ({
      params: { lang, id: projectSlug(project.id) },
      props: { lang, project, previous: own[i - 1], next: own[i + 1] },
    }))
  })
}

const { lang, project, previous, next } = Astro.props
const t = ui[lang]
const { title, lede, facts, links, say } = project.data
const { Content } = await render(project)
---

<MainLayout
  lang={lang}
  title={`${title} · ${site.name}`}
  description={lede}
  oyen="corner"
>
  <main>
    <div class="top">
      <a class="back" href={`/${lang}/`}>
        ← {site.name}
      </a>
      <LangSwitch lang={lang} />
    </div>

    <header>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <dl class="facts" data-say={say}>
        {facts.map(({ label, value }) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <nav class="links">
        {links.map(({ label, url }) => (
          <a href={url}>{label}</a>
        ))}
      </nav>
    </header>

    <article class="prose">
      <Content />
    </article>

    <nav class="pager">
      {previous && (
        <a href={projectPath(previous.id)}>
          <span>{t.previous}</span>
          <b>{previous.data.title}</b>
        </a>
      )}
      {next && (
        <a class="next" href={projectPath(next.id)}>
          <span>{t.next}</span>
          <b>{next.data.title}</b>
        </a>
      )}
    </nav>
  </main>
</MainLayout>

<style>
  main {
    max-width: 880px;
    padding-bottom: 260px;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 44px;
  }

  .back {
    display: inline-block;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--beak-text);
  }

  h1 {
    font-size: clamp(44px, 7.4vw, 88px);
    line-height: 0.95;
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .lede {
    max-width: 30em;
    margin-top: 22px;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0 24px;
    margin-top: 40px;
    border-top: 1.5px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }

  .facts div {
    padding: 14px 0 16px;
  }

  .facts dt {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .facts dd {
    margin: 2px 0 0;
    font-weight: 600;
    line-height: 1.3;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 96px;
    padding-top: 18px;
    border-top: 1.5px solid var(--ink);
  }

  .pager a {
    text-decoration: none;
  }

  .pager .next {
    margin-left: auto;
    text-align: right;
  }

  .pager span {
    display: block;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }

  .pager b {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .pager a:hover b {
    color: var(--beak-text);
  }

  @media (max-width: 1100px) {
    .top {
      justify-content: flex-start;
    }
  }

  @media (min-width: 1101px) {
    .top :global(.lang ul) {
      right: -13px;
      left: auto;
    }
  }

  @media (max-width: 760px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }

    .lede {
      font-size: 20px;
    }
  }
</style>
