---
import { getCollection } from 'astro:content'
import { projectSlug } from '../../data/ui'

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ id }) =>
    id.startsWith('en/')
  )
  return projects.map(({ id }) => ({ params: { id: projectSlug(id) } }))
}
---

<meta
  http-equiv="refresh"
  content={`0; url=/en/projects/${Astro.params.id}/`}
/>
