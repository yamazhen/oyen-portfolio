---
import { getCollection } from 'astro:content'
import { inLang, projectPath, projectSlug } from '../../data/ui'

export async function getStaticPaths() {
  const projects = await getCollection('projects', inLang('en'))
  return projects.map(({ id }) => ({
    params: { id: projectSlug(id) },
    props: { id },
  }))
}
---

<meta http-equiv="refresh" content={`0; url=${projectPath(Astro.props.id)}`} />
